# Server
PORT=3000
NODE_ENV=production

# Session (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET=your_very_long_random_session_secret_here

# Admin credentials
# Generate hash with: node -e "const b = require('bcryptjs'); b.hash('yourpassword', 12).then(h => console.log(h))"
ADMIN_EMAIL=admin@trendzation.co.uk
ADMIN_PASSWORD_HASH=$2b$12$your_bcrypt_hash_here

# Bateman AI tunnel (Cloudflare Tunnel URL for your Alienware)
BATEMAN_API_URL=https://your-tunnel-name.trycloudflare.com

# Database path (relative to project root)
DB_PATH=./data/trendzation.db

# Session store path
SESSION_DB_PATH=./data/sessions.db

# Contact form (optional - forward to Bateman)
FORWARD_CONTACTS_TO_BATEMAN=false
